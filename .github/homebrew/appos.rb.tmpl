# Generated by appos's release workflow from .github/homebrew/appos.rb.tmpl.
# Edit the template in https://github.com/StephanSchmidt/appos, not this file.
class Appos < Formula
  desc "Run sandboxed WebAssembly apps that marketing, sales and support ship"
  homepage "https://appos.build"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/StephanSchmidt/appos/releases/download/v@VERSION@/appos-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/StephanSchmidt/appos/releases/download/v@VERSION@/appos-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/StephanSchmidt/appos/releases/download/v@VERSION@/appos-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/StephanSchmidt/appos/releases/download/v@VERSION@/appos-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "appos", "appos-shell"
  end

  def caveats
    <<~EOS
      Building apps needs their language: Rust with
        rustup target add wasm32-wasip2
      TypeScript: Node.js 24+ and zig. Java: a JDK 21+ and Maven.
    EOS
  end

  test do
    system bin/"appos", "new", "hello", "--group", "Test"
    assert_match 'id = "hello"', (testpath/"hello/app.toml").read
    assert_match "appos-shell [--addr", shell_output("#{bin}/appos-shell --help")
  end
end
